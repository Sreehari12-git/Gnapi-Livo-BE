generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminLogin {
  id Int @id @default(autoincrement())
  email String @unique
  password String

  events  EventInfo[]
  controlPanelUsers ControlPanelLogin[]
  subscription Subscription?
  transactions Transaction[]
  usageSessions UsageSession[]
}

model SubscriptionPlan {
  id                Int @id @default(autoincrement())
  name              String
  amount            Int
  usageLimitMinutes Int
  subscriptions     Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  adminId     Int              @unique
  planId      Int
  status      String           @default("active")
  usedMinutes Float            @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  admin       AdminLogin       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Transaction {
  id        String   @id @default(uuid())
  adminId   Int
  orderId   String   @unique
  paymentId String?
  amount    Int
  currency  String   @default("INR")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     AdminLogin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model EventInfo {
  id             String         @id @default(uuid())
  name           String
  category       String         @default("sports")
  sport          String?
  createdBy      Int
  creator        AdminLogin     @relation(fields: [createdBy], references: [id])
  matchHistories     MatchHistory[]
  matches            Match[]
  deviceEventHistory DeviceEventHistory[]
}

model MatchHistory {
  id         String    @id @default(uuid())
  eventId    String
  matchId    String?   @unique
  sport      String
  name       String
  teamAName  String
  teamBName  String
  teamAScore Int
  teamBScore Int
  createdAt  DateTime  @default(now())
  event      EventInfo @relation(fields: [eventId], references: [id])
  match      Match?    @relation(fields: [matchId], references: [id])
}

model ControlPanelLogin {
  id       Int        @id @default(autoincrement())
  name     String
  email    String     @unique
  password String
  adminId Int
  admin AdminLogin @relation(fields: [adminId], references: [id])
}



model Match {
  id                        String    @id @default(uuid())
  eventId                   String
  event                     EventInfo @relation(fields: [eventId], references: [id])
  sport                     String
  name                      String
  liveStatus                String    @default("not_started")
  liveCapturerIdentities    String[]
  liveCommentatorIdentities String[]
  ytBroadcastId           String?
  ytStreamId              String?
  ytWhipUrl               String?
  ytLiveUrl                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  history                   MatchHistory?
  recordings                MatchRecording[]
}

model MatchRecording {
  id               String   @id @default(uuid())
  matchId          String
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  capturerIdentity String
  egressId         String   @unique
  recordingUrl     String
  createdAt        DateTime @default(now())
}

model DeviceEventHistory {
  id           String    @id @default(uuid())
  deviceId     String
  eventId      String
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  event        EventInfo @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([deviceId, eventId])
  @@index([deviceId])
}

model UsageSession {
  id              String    @id @default(uuid())
  adminId         Int
  room            String
  identity        String
  role            String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Float?

  admin AdminLogin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([room, identity])
}
