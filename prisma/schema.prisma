generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminLogin {
  id Int @id @default(autoincrement())
  email String @unique
  password String 

  events  EventInfo[]
  controlPanelUsers ControlPanelLogin[]
}

model EventInfo {
  id             String         @id @default(uuid())
  name           String
  createdBy      Int
  creator        AdminLogin     @relation(fields: [createdBy], references: [id])
  matchHistories MatchHistory[]
  deviceEvents DeviceEvent[]
  matches        Match[]
}

model MatchHistory {
  id         String    @id @default(uuid())
  eventId    String
  matchId    String?   @unique
  sport      String
  name       String
  teamAName  String
  teamBName  String
  teamAScore Int
  teamBScore Int
  createdAt  DateTime  @default(now())
  event      EventInfo @relation(fields: [eventId], references: [id])
  match      Match?    @relation(fields: [matchId], references: [id])
}

model ControlPanelLogin {
  id       Int        @id @default(autoincrement())
  name     String
  email    String     @unique
  password String
  adminId Int
  admin AdminLogin @relation(fields: [adminId], references: [id])
}

model DeviceEvent {
  id        String   @id @default(uuid())
  deviceId  String
  eventId   String
  createdAt DateTime @default(now())

  event EventInfo @relation(fields: [eventId], references: [id])

  @@unique([deviceId, eventId])
}

model LiveSelection {
  id                      String   @id @default(uuid())
  room                    String   @unique
  liveCapturerIdentity    String?
  liveCommentatorIdentity String?
  updatedAt               DateTime @updatedAt
}

model Match {
  id                      String    @id @default(uuid())
  eventId                 String
  event                   EventInfo @relation(fields: [eventId], references: [id])
  sport                   String
  name                    String
  liveStatus              String    @default("not_started")
  liveCapturerIdentity    String?
  liveCommentatorIdentity String?
  ytBroadcastId           String?
  ytStreamId              String?
  ytWhipUrl               String?
  ytLiveUrl               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  history                 MatchHistory?
}

